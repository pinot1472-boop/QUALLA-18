# ═══════════════════════════════════════════════════════════════════════
#  Qullamaggie Fused v2  ->  Bot para BingX + Telegram
#
#  EN RAILWAY:  tu servicio -> pestaña "Variables" -> "Raw Editor" y pega esto
#               (solo hace falta TELEGRAM_BOT_TOKEN y TELEGRAM_CHAT_ID; el resto
#               ya trae por defecto los valores del script de TradingView).
#  EN LOCAL:    copia este archivo a ".env" (el bot lo lee solo).
#
#  NUNCA subas tu ".env" real ni tu token a GitHub.
# ═══════════════════════════════════════════════════════════════════════

# ── Telegram (OBLIGATORIO) ──────────────────────────────────────────────
# Token que te da @BotFather
TELEGRAM_BOT_TOKEN=123456789:PON-AQUI-EL-TOKEN-DE-BOTFATHER
# ID del chat, grupo o canal destino. Se pueden poner varios separados por coma.
TELEGRAM_CHAT_ID=123456789
# Solo para mostrar la hora local en los mensajes (ej.: Europe/Madrid, America/Mexico_City, UTC)
TIMEZONE=UTC
# true = no envía nada a Telegram, solo escribe los mensajes en el log (para probar)
DRY_RUN=false

# ── General / sesión (grupos "General" y "Sesión" del Pine) ─────────────
# Timeframe de las velas: 1m, 3m, 5m, 15m, 30m o 1h (recomendado 5m o 15m)
TIMEFRAME=5m
# BOTH, EP_LONG o PARABOLIC_SHORT
ACTIVE_SETUP=BOTH
# Minutos desde las 00:00 UTC hasta la "apertura". Cripto: 0. Apertura US: 810 (13:30 UTC en horario
# de verano) u 870 (14:30 UTC en invierno)
SESSION_OFFSET_MIN=0
OR_MINUTES=15
SKIP_FIRST_MIN=5
# Ventana de entradas en minutos desde la apertura (0 = todo el día)
ENTRY_WINDOW_MIN=1080
DAY_LEN_MIN=1440
MAX_TRADES_DAY=2
# Frontera del "día" respecto a 00:00 UTC, en minutos. -1 = autodetectar con las velas diarias de BingX
# DAY_OFFSET_MIN=-1

# ── Riesgo (grupo "Riesgo Qullamaggie") ─────────────────────────────────
# Capital de referencia para calcular el tamaño sugerido (no se compone con las operaciones)
ACCOUNT_EQUITY=10000
RISK_PCT_EP=0.35
RISK_PCT_SHORT=0.25
MAX_POS_PCT=22
MAX_ADR_MULT=1.3
# DAY = mínimo/máximo del día, OR = mínimo/máximo del Opening Range, ATR = 2 x ATR
STOP_MODE=DAY
SL_BUFFER_ATR=0.1

# ── EP Long ─────────────────────────────────────────────────────────────
EP_MIN_CHANGE=7.0
EP_MIN_ADR=3.5
EP_MIN_RVOL=1.5
# ORH (ruptura del OR High), VWAP_EMA o HH (máximo de 10 velas)
EP_TRIGGER=ORH

# ── Parabolic Short ─────────────────────────────────────────────────────
PS_MIN_GAIN=50
PS_LOOKBACK=15
PS_MIN_GREEN=3
PS_MIN_EXT=25
# ORL (pérdida del OR Low), FIRST_RED o VWAP_FAIL
PS_TRIGGER=ORL

# ── Gestión común ───────────────────────────────────────────────────────
PARTIAL_R=1.8
PARTIAL_PCT=50
USE_TRAIL_EMA=true
# 10 o 20
TRAIL_EMA_LEN=10
# Máximo de velas en posición (0 = desactivado)
MAX_HOLD_BARS=0

# ── Bot / infraestructura ───────────────────────────────────────────────
# Peticiones por segundo a BingX. El límite público es 100 cada 10 s: no pases de 9
RATE_PER_SEC=8
CONCURRENCY=8
# Segundos de espera tras el cierre de cada vela antes de escanear
SCAN_DELAY_SEC=6
# Las señales detectadas con más de estas velas de retraso se ignoran
MAX_SIGNAL_AGE_BARS=2
# Velas extra descargadas para estabilizar EMA21 y ATR14
WARMUP_BARS=250
# Para analizar solo algunos pares (vacío = todos los perpetuos USDT de BingX). Ej.: BTC-USDT,ETH-USDT
# SYMBOLS=BTC-USDT,ETH-USDT
# Pares que se excluyen (por defecto, las acciones/forex/materias primas que BingX lista como NCSK/NCFX/NCCO/NCSI)
EXCLUDE_REGEX=^NC(SK|FX|CO|SI)
# Filtro de liquidez: volumen medio diario mínimo en USDT (0 = sin filtro; p. ej. 1000000 descarta microcaps)
MIN_DAILY_VOL_USDT=0
# true = avisa también cuando un par queda "EP armado" o "Parabolic activo" (más mensajes)
NOTIFY_ARMED=false
# Mensaje de "bot activo" cada N horas (0 = desactivado)
HEARTBEAT_HOURS=12
# Carpeta del state.json. En Railway: crea un Volume, móntalo en /data y pon DATA_DIR=/data
DATA_DIR=.
LOG_LEVEL=INFO
# Solo necesario si algún día hay que usar otro dominio de la API de BingX
# BINGX_BASE_URL=https://open-api.bingx.com
